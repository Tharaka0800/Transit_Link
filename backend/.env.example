# Node.js 22+ is required. For a new setup, copy to ignored .env.local.
# For this existing app, copy only the Supabase entries to .env.local;
# the existing MongoDB/JWT entries continue to load from .env.
PORT=5000
NODE_ENV=development

# Existing login/profile/notifications still use MongoDB and the existing JWT.
MONGO_URI=mongodb://127.0.0.1:27017/transitlink
USE_MEMORY_DB=false
AUTO_SEED=false
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRE=30d

# Incident data uses Supabase. Put these values in ignored backend/.env.local.
# The server key must never enter the frontend or the tracked .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-server-only-key
# A legacy SUPABASE_SERVICE_ROLE_KEY can be supplied instead of SUPABASE_SECRET_KEY.

# Optional comma-separated web origins. Empty retains existing development CORS.
# Native clients do not send a browser Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
