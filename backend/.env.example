# Reference for the existing account, profile, and notification backend.
# The restored JavaScript server reads backend/.env.
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/transitlink
# Set true for the existing in-memory demo database (reset on server restart).
USE_MEMORY_DB=false
# Initialize demo accounts and notifications on startup when using MongoDB.
AUTO_SEED=false
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRE=30d

# The Transport Officer feature stores incidents locally using AsyncStorage.
# It requires no backend configuration.
